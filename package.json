{
  "name": "@synthflow-ai/n8n-nodes-synthflow",
  "version": "0.2.0",
  "description": "n8n node for Synthflow AI - Make a Call endpoint",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "synthflow",
    "ai",
    "voice",
    "call"
  ],
  "license": "MIT",
  "homepage": "https://github.com/yourusername/n8n-nodes-synthflow",
  "author": {
    "name": "Your Name",
    "email": "your.email@example.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/n8n-nodes-synthflow.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json --ext .ts,.js",
    "lintfix": "eslint nodes credentials package.json --fix --ext .ts,.js",
    "prepublishOnly": "npm run build && eslint -c .eslintrc.prepublish.js nodes credentials package.json --ext .ts,.js",
    "test": "jest",
    "prepare": "husky install"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SynthflowApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Synthflow/Synthflow.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.29.0",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "n8n-workflow": "^1.0.0",
    "prettier": "^2.7.1",
    "ts-jest": "^29.4.5",
    "typescript": "^4.9.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": [
      "prettier --write"
    ],
    "*.{ts,js}": [
      "eslint --fix"
    ]
  }
}
