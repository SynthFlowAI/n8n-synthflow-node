{
	"compilerOptions": {
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"importHelpers": true,
		"module": "commonjs",
		"outDir": "dist",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "ES2019",
		"lib": ["ES2019"],
		"moduleResolution": "node",
		"forceConsistentCasingInFileNames": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["credentials/**/*", "nodes/**/*"],
	"exclude": ["node_modules/**/*", "dist/**/*"]
}

